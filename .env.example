# Copy this file to .env and fill in your own values.
#
# Docker/Kubernetes secrets: any variable below can instead be supplied as
# <NAME>_FILE pointing at a file containing the value, e.g.
#   JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_key
# <NAME>_FILE takes precedence over <NAME>. This keeps credentials out of
# `docker inspect`, compose files, and the Unraid template.

# Server Configuration
PORT=3000

# Switch a media system off without clearing its settings (default: enabled)
# KALEIDESCAPE_ENABLED=false
# PLEX_ENABLED=false
# JELLYFIN_ENABLED=false

# Kaleidescape Configuration
# HOST must be the *player* (Strato/Alto/Player) - it answers play-status queries.
KALEIDESCAPE_PLAYER_HOST=192.168.1.50
KALEIDESCAPE_PORT=10000
# Set SERVER_HOST only if the movie library lives on a separate server (e.g. Terra).
# A movie server rejects play-status commands; a player has no /movies page.
KALEIDESCAPE_SERVER_HOST=

# Plex Configuration
PLEX_URL=http://192.168.1.60:32400
PLEX_TOKEN=your_plex_token_here

# Jellyfin Configuration
JELLYFIN_URL=http://192.168.1.61:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# TheMovieDB Configuration (for movie metadata)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_token_here

# OMDb Configuration (for Rotten Tomatoes scores - get free key at http://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your_omdb_api_key_here

# Polling interval in milliseconds (default: 10000 = 10 seconds)
POLL_INTERVAL=10000

# Idle slideshow interval in milliseconds (default: 30000 = 30 seconds)
SLIDESHOW_INTERVAL=30000
